# Banco: "memory" sobe um MongoDB em memoria (dev, dados somem ao reiniciar).
# Para persistir, troque pela connection string do MongoDB Atlas.
MONGO_URI=memory

JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
PORT=3000

# IA: "mock" (respostas ficticias, sem chave) ou "gemini" (IA real)
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origem permitida no CORS em producao (em dev tudo e permitido)
CORS_ORIGIN=

# Codigo exigido no cadastro de professores (se vazio, cadastro de professor fica desativado)
TEACHER_INVITE_CODE=professor-demo

# Cria usuarios/turma/caderno de demonstracao ao iniciar (so dev)
SEED_DEMO=false
